def pickupfinishedbox():
   set_standard_digital_out(2, False)
   set_standard_analog_out(0, 0.25)
   sleep(0.1)
   set_standard_digital_out(1, False)
   set_standard_analog_out(1, 0.0) 
   
   sleep(2)
   movel(pickbox, t = 0.1)
   
   set_standard_analog_out(0, 0.33)
   sleep(0.3)
   movel(afterpickbox, t = 0.1)
   movel(postafterpickbox, t = 0.5)
   movel(finalpospre1, t = 0.1)
   movel(finalpospre2, t = 0.1)
   set_standard_analog_out(0, 0.0)
   sleep(1)
   movel(finalposreal, t = 0.1)
   movel(finalpospre1, t = 0.1)
   movej(predoospickup, t = 0.1)

end 

def moveto_scanner():
    movej(posscan, a=1.2, v=0.25)
end

def moveto_home():
    movel(home_pos, a=1.2, v=0.25)
end

def is_homing_coord(coords, homing_list):
   tol = 0.0001
   i = 0
   check = True
   while i <=  7:
        textmsg(coords[i])
        textmsg(homing_list[i])
        value = coords[i] - homing_list[i]
        textmsg(value)
          if value < 0:
           value = -value
          end
       if value > tol:
          check = False
          break
       end
       i = i + 1
    end
    if check == False:
       return False
    else:
       return True
    end
   end

    


def main():
    homing_coords = [8, 0, 0, 0, 0, 0, 0, 0, 0]
    socket_open(ip, 12344, socket_name)
    testmsg = socket_read_string(socket_name, timeout=0)
    failposGiftbox = p[0.15934, -0.31519, 0.38262, 0.000, 3.141, 0.000]
    failposWallet = p[0.33442, -0.31519, 0.38262, 0.000, 3.141, 0.000]
#failposWallet = p[0.29799, -0.02612, 0.32801, 0.021, 3.131, -0.177]
    currentIndex = 1

    while True:
        textmsg(testmsg)
        testmsg = socket_read_string(socket_name, timeout=0)
        if testmsg == "start":
            break
        end
        sleep(0.1)
    end

    while True:

        ########send giftbox send, recv and move
        socket_send_string("SEND_GIFTBOX_COORDINATES", socket_name)
        coords = socket_read_ascii_float(8, socket_name, timeout=0)
        textmsg("Received coordinates:", coords)
        sig = get_sig(coords)
        fail = get_fail(coords)

        #textmsg("Received coordinates: ", coords)
        ####als de server zegt stop dan bewegen naar home en dan stoppen
        
        ###pickup giftbox als hij niet moest homen 
        moveto_opener(sig, fail,  coords)
        

        ####wallet coords send, recv and move
        socket_send_string("SEND_WALLET_COORDINATES", socket_name)
        coordsWallet = socket_read_ascii_float(8, socket_name, timeout=0)
        textmsg("Received coordinates: ",  coordsWallet)
        set_standard_analog_out(0, 0.275)
        sigWallet = get_sig(coordsWallet)
        failWallet = get_fail(coordsWallet)
        if failWallet == 1:
        	moveto_opener(sigWallet, failWallet, coordsWallet)
        end



        #####wallet scannen send, recv and move
        if failWallet ==1:
        	socket_send_string("SCAN_WALLET", socket_name)
        	correct = socket_read_string(socket_name, timeout=0)
        	textmsg("passed check: ",  correct)
	placingwalletAndDroppingGiftbox(currentIndex,correct)
        end

        #####cycle completed send, recv and move
        socket_send_string("CYCLE_COMPLETED", socket_name)
        correct = socket_read_string(socket_name, timeout=0)
        if correct == "false":
            textmsg("Homing robot")
            moveto_home()
            break
        end
        textmsg("Received coordinates: ", correct)
        currentIndex = currentIndex + 1

        sleep(0.01)
    end

    socket_close(socket_name)
end

########################################
# ----------- START --------------------
########################################

main()

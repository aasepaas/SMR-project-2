def failMove(sig):
    if sig == 0:    
        movel(failposGiftbox, t = 3)
        set_standard_analog_out(0, 0.0)
        failCounterGiftbox = failCounterGiftbox + 1
        failposGiftbox[1] = failposGiftbox[1] - 0.02
        failposGiftboxHoger = set_pose_z(failposGiftbox, afterPickupZvoorWallet)
        movel(failposGiftboxHoger, t=1)
        sleep(0.1)
    else:
        movel(failposWallet, t=3)
        textmsg(failposWallet)
        set_standard_analog_out(0, 0.0)
        failCounterWallet = failCounterWallet + 1
        failposWallet[1] = failposWallet[1] - 0.02
        failposWalletHoger = set_pose_z(failposWallet, afterPickupZvoorWallet)
        movel(failposWalletHoger, t=1)
        sleep(0.1)
    end
end

def pickupWallet(coords, fail, sig):
    pickupPose = makepose(coords)
    prePickupPose = set_pose_z(pickupPose, prePickupZvoorWallet)
    postpickup = set_pose_z(pickupPose, afterPickupZvoorWallet)
    #openBoxWithMold(prepickup)
    set_standard_analog_out(0, 0.29)
    set_standard_analog_out(1, 0.23)
    movej(prePickupPose, t= 0.1)
  
    movel(pickupPose, t = 0.1)
    set_standard_analog_out(0, 0.33)
    sleep(1)
    movel(prePickupPose, t = 0.1)
    
    sleep(1.2)
    set_standard_digital_out(1, True)
    sleep(0.1)
    set_standard_digital_out(2, True)
    set_standard_analog_out(1, 0.0)
    
    movej(posscan)
    
    
end

def pickupGiftbox(coords, fail, sig):
    set_standard_analog_out(0, 0.0)
    pickupPose = makepose(coords)
    prePickupPose = set_pose_y(pickupPose, prePickupYvoorGiftbox)
    postpickup = set_pose_y(pickupPose, afterPickupYvoorGiftbox)
    movel(prePickupPose, t = 0.1)
    set_standard_digital_out(0, True)
    movel(pickupPose, t = 0.5)
    movel(prePickupPose, t = 0.1)
    set_standard_analog_out(0, 0.33)
    sleep(0.7)
    set_standard_digital_out(0, False)
    movel(postpickup)
    sleep(0.1)
    if fail == 0:
        failMove(sig)

    else:
        movel(doosbovenmal, t = 0.5)
        movel(doosbovenmal2, t = 0.5)
        movel(doosinmal, t = 0.5)


        set_standard_analog_out(0, 0.24)
        movel(robotnamal, t = 1)
    end
    
end

def moveto_opener(sig, fail, coords):
    #fail = get_fail(coords)
    if sig == 1:
        pickupWallet(coords, fail, sig)
    else:
        pickupGiftbox(coords, fail, sig)
    end
end

def placingwalletAndDroppingGiftbox(currentIndex, correct):
    movej(postposscan, t = 0.4)
    movel(walletplacing1)
    set_standard_analog_out(0, 0.0)
    sleep(0.2)
    movel(postwalletplacing)
    set_standard_analog_out(1, 0.23) 
    sleep(1)
    set_standard_digital_out(2, False)
    sleep(0.1)
    set_standard_digital_out(1, False)
    set_standard_analog_out(1, 0.0) 
    set_standard_analog_out(0, 0.25)
    sleep(2)
    movel(pickbox, t = 0.1)
    set_standard_analog_out(0, 0.33)
    sleep(0.8)
    movel(afterpickbox, t = 0.1)
    #####hier logica voor foute wallet scan
    if correct == "true":
            movel(postafterpickbox, t = 0.1)
            currentPlacingGiftboxBackCoords(currentIndex)
    else:
             failWalletAndGiftbox()
    end	


    

end


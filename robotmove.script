# Define coordinates
coords = p[0.53938, 0.01027, 0.21500, 0.084, -3.152, -0.022]
lowerzwallet = 0.19500
raisezwallet = 0.21500
walletscanner_pos = p[0.53938, 0.01027, 0.30000, 0.084, -3.152, -0.022]
boxscanner_pos = p[0.40000, -0.20000, 0.30000, 0.084, -3.152, -0.022]
home_pos = p[0.31100, -0.21680, -0.19100, 0.31400, -3.1390, -0.014]

ip = "192.168.0.43"
socket_name = "socket1"





# Function to apply new Z
def set_pose_z(pose, new_z):
    return p[pose[0], pose[1], new_z, pose[3], pose[4], pose[5]]
end

# Function to move to target
def moveto_target_coords(coords):
    set_standard_analog_out(0, 0)
    movel(coords, a=1.2, v=0.25)
    movel(set_pose_z(coords, lowerzwallet))
    set_standard_digital_out(0, True)
    set_standard_analog_out(0, 0.33) 
    movel(set_pose_z(coords, 0.26018))
    movel(set_pose_z(coords, raisezwallet))
    sleep(1)
    set_standard_digital_out(0, False)
end

def moveto_scanner(msg):
    if msg == "wallet":
        movel(walletscanner_pos, a=1.2, v=0.25)
        scan(wallet=True)
    elif msg == "box":
        movel(boxscanner_pos, a=1.2, v=0.25)
        scan(wallet=False)
    else:
        popup("Error: Unknown scanner position", title="Error", error=True)
        textmsg("error: unknown scanner position")
        socket_send_string("error: unknown scanner position", socket_name)
    sleep(1)
end

def scan(wallet=False):
  if wallet:
      socket_send_string(socket_name, "SCAN_WALLET")
  else:
      socket_send_string(socket_name, "SCAN_GIFTBOX")
  while True:
    correct = socket_read_string(socket_name, timeout=0)
    if correct == "correct":
      moveto_opener(failstate=False)
      break
    else if correct == "incorrect":
      moveto_opener(failstate=True)
      break
    else:
      popup("Error: Unknown scan result", title="Error", error=True)
      textmsg("error: unknown scan result")
      socket_send_string("error: unknown scan result", socket_name)
      sleep(1)
      continue
    
    

def moveto_home():
    movel(home_pos, a=1.2, v=0.25)
end

def moveto_opener(failstate=False):
    # Use correct variables
    movel(openerpos, a=1.2, v=0.5)
    if get_standard_digital_out(2):
        set_standard_digital_out(2, False)  # deactivate motor
        sleep(1000)

    movel(lowerzwallet, a=1.2, v=0.25)
    
    if failstate:
        set_standard_analog_out(1, 0.33)
        sleep(1)
        movel(raisezwallet, a=1.2, v=0.25)
        movel(failurepos, a=1.2, v=0.5)
        set_standard_analog_out(1, 0.0)
        sleep(1)
    else:
        set_standard_analog_out(1, 0.0)
        sleep(1)
        movel(raisezwallet, a=1.2, v=0.25)
        set_standard_digital_out(2, True)
        sleep(2)
end

def main():
  socket_open(socket_name, ip, 30002)
  while True:
    if socket_read_string(socket_name, timeout=0) == "stop":
      break
    coords = socket_read_string(socket_name, timeout=0)
    moveto_target_coords(coords)
    socket_send_string("picked", socket_name)
    msg = socket_read_string(socket_name, timeout=0)
    moveto_scanner(msg)
    
    coordswallet = socket_read_string(socket_name, timeout=0)
    moveto_target_coords(coordswallet)
    socket_send_string("pickedwallet", socket_name)
    msg = socket_read_string(socket_name, timeout=0)
    moveto_scanner(msg)
    
  
  moveto_home()
  socket_close(socket_name)


# --- CALL THE FUNCTION SAFELY ---
moveto_target_coords(coords)
